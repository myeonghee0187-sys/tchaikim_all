        "lines": 1.9998562116564418
      },
      {
        "text": "Choose the cloth by touch and colour, then settle the measurements.",
        "lines": 1.9998562116564418
      },
      {
        "text": "One pair of hands, from first stitch to last.",
        "lines": 0.9999281058282209
      },
      {
        "text": "A final fitting and last adjustments, then pressed and wrapped.",
        "lines": 1.9998562116564418
      },
      {
        "text": "Soft silk with graceful drape and deep, even colour.",
        "lines": 1.999289772727273
      },
      {
        "text": "Breathable cotton that softens with every wearing.",
        "lines": 1.999289772727273
      },
      {
        "text": "Flax linen holds its structure, with room for air to move.",
        "lines": 1.999289772727273
      },
      {
        "text": "Cool, translucent mosi, worn through Korean summers.",
        "lines": 1.999289772727273
      },
      {
        "text": "A short run of cloth, chosen for one season only.",
        "lines": 1.999289772727273
      },
      {
        "text": "Sangju Myungjoo silk, with a quiet, uneven lustre.",
        "lines": 1.999289772727273
      }
